{
  "name": "burgundysuite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "d1:create": "wrangler d1 create burgundysuite-db",
    "d1:migrate": "wrangler d1 execute burgundysuite-db --remote --file=./migrations/0001_initial_schema.sql",
    "d1:seed": "wrangler d1 execute burgundysuite-db --remote --file=./migrations/seed.sql",
    "d1:migrate:local": "wrangler d1 execute burgundysuite-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:seed:local": "wrangler d1 execute burgundysuite-db --local --file=./migrations/seed.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
