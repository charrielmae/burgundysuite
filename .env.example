# ========================================================
# Burgundy Suite & Resort — Cloudflare Authentication & D1
# ========================================================

# 1. Cloudflare D1 Database Credentials
# Run `npm run d1:create` to create a D1 database named `burgundysuite-db`.
# Copy the database_id from the command output into CLOUDFLARE_DATABASE_ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# 2. Cloudflare Access (Zero Trust) Authentication (Optional)
# If protecting your domain with Cloudflare Access (Zero Trust),
# fill in your team domain name (e.g. burgundy-suite.cloudflareaccess.com).
CLOUDFLARE_ACCESS_TEAM_NAME=
CLOUDFLARE_ACCESS_AUD=

# 3. Cloudflare Turnstile Bot Protection (Optional)
# Obtain from Cloudflare Dashboard > Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# 4. Session Security Key
AUTH_SECRET=burgundy-luxury-secret-key-2026

# 5. Cloudflare R2 Object Storage
# Endpoint: https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com/<CLOUDFLARE_R2_BUCKET_NAME>
CLOUDFLARE_R2_ACCOUNT_ID=b730d1dce2f590cd1ae5726758a0e590
CLOUDFLARE_R2_BUCKET_NAME=burgundy-bucket
CLOUDFLARE_R2_ENDPOINT=https://b730d1dce2f590cd1ae5726758a0e590.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# 6. Better Auth & Better Auth Infra Dashboard
BETTER_AUTH_API_KEY=ba_5diwn7iln50fvodfad62ehxq7oxf48fs
BETTER_AUTH_SECRET=burgundy-luxury-secret-key-2026-auth-secret
BETTER_AUTH_URL=http://localhost:3000

